  "item": [
    {
      "name": "1. Authentication",
      "description": "Endpoint seputar otentikasi: Register, Login (auto extract token), Logout, dan skenario validasi negatif.",
      "item": [
        {
          "name": "1.1 Login (Auto Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Login successful with token\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"auth_token\", jsonData.data.token);",
                  "    pm.environment.set(\"auth_token\", jsonData.data.token);",
                  "    console.log(\"Saved auth_token:\", jsonData.data.token.substring(0, 15) + \"...\");",
                  "}",
                  "",
                  "if (jsonData.data && jsonData.data.refreshToken) {",
                  "    pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
                  "    pm.environment.set(\"refresh_token\", jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{default_username}}\",\n  \"password\": \"{{default_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login dengan kredensial default. Test script akan otomatis menyimpan `auth_token` ke Collection dan Environment Variable untuk digunakan request berikutnya."
          },
          "response": []
        },
        {
          "name": "1.2 Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Register successful\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Administrator User\",\n  \"username\": \"user_{{$randomAlphaNumeric}}\",\n  \"email\": \"user_{{$randomAlphaNumeric}}@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Mendaftarkan user baru dengan password yang sesuai."
          },
          "response": []
        },
        {
          "name": "1.3 Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Logout message success\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "});"
