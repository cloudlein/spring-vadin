          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Expect 401 Unauthorized for invalid refresh token\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
