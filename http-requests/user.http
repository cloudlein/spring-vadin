### ====================================================================
### USER MANAGEMENT API TEST SUITE
### Base URL: {{baseUrl}}/users
### Requires: Bearer {{auth_token}} (run auth.http -> Login first)
### ====================================================================

### 1. Get All Users (Paginated & Search)
# @name getAllUsers
GET {{baseUrl}}/users?page=0&size=10&search=
Authorization: Bearer {{auth_token}}
Accept: application/json

> {%
    client.test("Get all users returns 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 2. Create User
# @name createUser
POST {{baseUrl}}/users
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Jane Doe",
  "username": "janedoe_{{$random.alphabetic(3)}}",
  "email": "janedoe_{{$random.alphabetic(3)}}@example.com",
  "password": "Password123!",
  "roleId": 1
}

> {%
    client.test("Create user returns 200/201", function() {
        client.assert(response.status === 200 || response.status === 201, "Status was " + response.status);
    });
%}

### 3. Get User by ID
# @name getUserById
GET {{baseUrl}}/users/1
Authorization: Bearer {{auth_token}}
Accept: application/json

> {%
    client.test("Get user by ID returns 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 4. Update User
# @name updateUser
PUT {{baseUrl}}/users/1
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "name": "Jane Doe Updated",
  "username": "janedoe_updated",
  "email": "janedoe_updated@example.com",
  "password": "NewPassword123!",
  "roleId": 1
}

> {%
    client.test("Update user returns 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 5. Delete User
# @name deleteUser
DELETE {{baseUrl}}/users/1
Authorization: Bearer {{auth_token}}

> {%
    client.test("Delete user returns 200/204", function() {
        client.assert(response.status === 200 || response.status === 204, "Response status was " + response.status);
    });
%}

### 6. [Negative] Unauthorized Access without Token
GET {{baseUrl}}/users
Accept: application/json

> {%
    client.test("Should be rejected with 401/403 Unauthorized", function() {
        client.assert(response.status === 401 || response.status === 403, "Expected 401/403, got " + response.status);
    });
%}
